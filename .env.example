# Copy to .env and fill in for local dev. Never commit the real .env.

# "prod" or "demo" — selects the Clock implementation and time_scale
# (builder doc §10.2/§10.3). Property tests ignore this and always use
# "prod" directly (CLAUDE.md rule 3).
CONFIG_PROFILE=prod

# Postgres — case state (always) and outbox commits (until/unless the
# hour-20 gate flips CommitBackend to etcd, §10.1).
POSTGRES_DSN=postgresql://recovery:recovery@localhost:5432/recovery

# etcd — quorum commit backend (§3). Only needed once EtcdQuorumBackend is
# wired in during Phase 2.
ETCD_HOST=localhost
ETCD_PORT=2379

# Razorpay test-mode webhook secret, once Phase 0 confirms the real payload
# shape and signing scheme.
RAZORPAY_WEBHOOK_SECRET=
